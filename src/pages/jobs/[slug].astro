---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Cite from '@/components/Cite.tsx';
import Figure from '@/components/Figure.astro';
import { RankedBars, TestBars } from '@/components/charts/Index';
import { categoryMeta, protectionWord, readProfile, verdictMeta, cleanPath, site } from '@/lib/site';
import { getSource } from '@/data/sources';

export async function getStaticPaths() {
  const jobs = await getCollection('jobs');
  const paths = [];

  for (const job of jobs) {
    const note = await getEntry('jobNotes', job.id);
    // A folder with data but no note is a build failure, not a page with a hole in it.
    if (!note) throw new Error(`Job "${job.id}" has job.json but no notes.md(x) — add the prose file.`);
    paths.push({ params: { slug: job.id }, props: { job, note } });
  }

  return paths;
}

interface Props {
  job: CollectionEntry<'jobs'>;
  note: CollectionEntry<'jobNotes'>;
}

const { job, note } = Astro.props;
const d = job.data;
const v = verdictMeta[d.verdict];
const { Content } = await render(note);
const profile = readProfile(d.tests, d.verdict);

const url = new URL(cleanPath(Astro.url.pathname), Astro.site ?? site.url).href;
const origin = new URL(url).origin;
const built = new Date().toISOString().slice(0, 10);

const jsonLd = [
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: d.name,
    description: d.oneLiner,
    articleSection: categoryMeta[d.category] ?? d.category,
    inLanguage: 'en',
    isPartOf: { '@id': `${origin}/#website` },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    author: { '@id': `${origin}/#publisher` },
    publisher: { '@id': `${origin}/#publisher` },
    dateModified: built,
    about: { '@type': 'Occupation', name: d.name },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
      { '@type': 'ListItem', position: 2, name: 'All jobs', item: `${origin}/jobs` },
      { '@type': 'ListItem', position: 3, name: d.short, item: url },
    ],
  },
];

const all = (await getCollection('jobs')).sort((a, b) => a.data.order - b.data.order);
const index = all.findIndex((j) => j.id === job.id);
const prev = index > 0 ? all[index - 1] : undefined;
const next = index < all.length - 1 ? all[index + 1] : undefined;

const growth = d.series.find((s) => s.kind === 'growth');
const chartBars = growth
  ? [
      {
        label: d.short,
        value: growth.value,
        display: `${growth.value > 0 ? '+' : ''}${growth.value}%`,
        source: growth.source,
        tone: 'survive' as const,
      },
    ]
  : [];
---

<Base title={d.name} description={d.oneLiner} ogType="article" jsonLd={jsonLd} image={`/og/jobs-${job.id}.png`}>
  <article class="wrap pt-8 pb-16">
    <nav class="flex flex-wrap items-center gap-2 font-mono text-[11px] uppercase tracking-[0.12em] text-faint">
      <a href="/jobs" class="no-underline hover:text-ink">All jobs</a>
      <span>/</span>
      <span>{categoryMeta[d.category] ?? d.category}</span>
    </nav>

    <header class="mt-6 border-b border-line-soft pb-8">
      <div class="flex flex-wrap items-center gap-3">
        <span
          class="num rounded-full border px-2.5 py-[3px] text-[11px] uppercase tracking-[0.12em]"
          style={`border-color:${v.color}; color:${v.color}`}>{v.label}</span
        >
        <span class="eyebrow">{v.blurb}</span>
      </div>
      <h1 class="mt-5 max-w-[22ch] font-display text-[clamp(2.2rem,5vw,3.6rem)]">{d.name}</h1>
      <p class="lede mt-4">{d.oneLiner}</p>
      <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
        {
          d.horizon && (
            <div>
              <dt class="eyebrow">Horizon</dt>
              <dd class="num mt-1 text-[14px]">{d.horizon}</dd>
            </div>
          )
        }
        {
          d.wage && (
            <div>
              <dt class="eyebrow">Pay</dt>
              <dd class="num mt-1 text-[14px]">{d.wage}</dd>
            </div>
          )
        }
        <div>
          <dt class="eyebrow">Protection from automation</dt>
          <dd class="mt-1 text-[14px]">{protectionWord(profile.total)} · our reading</dd>
        </div>
      </dl>
    </header>

    {
      d.metrics.length > 0 && (
        <section class="grid gap-x-10 gap-y-6 border-b border-line-soft py-8 sm:grid-cols-2 lg:grid-cols-4">
          {d.metrics.map((m) => (
            <div class="hairline pt-4">
              <div class="num text-[26px] leading-none" style={`color:${v.color}`}>
                {m.display}
              </div>
              <div class="mt-2 text-[13px] leading-relaxed text-faint">{m.label}</div>
              <a
                href={`/sources#${m.source}`} target="_blank" rel="noopener"
                class="num mt-3 inline-block rounded border border-line px-1.5 py-0.5 text-[10.5px] text-faint no-underline hover:border-signal hover:text-ink"
              >
                {getSource(m.source).short}
              </a>
            </div>
          ))}
        </section>
      )
    }

    <div class="grid gap-10 py-10 lg:grid-cols-[1.5fr_1fr] lg:items-start">
      <div>
        <div class="prose-body text-[15.5px]">
          <Content components={{ Cite }} />
        </div>

        <div class="mt-10 grid gap-6 sm:grid-cols-2">
          {
            d.why.length > 0 && (
              <div class="hairline pt-5">
                <div class="eyebrow text-survive">What holds it up</div>
                <ul class="mt-3 space-y-2">
                  {d.why.map((w) => (
                    <li class="flex gap-3 text-[14px] leading-relaxed text-muted">
                      <span class="mt-[9px] h-px w-3 shrink-0 bg-survive" />
                      <span>{w}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
          {
            d.threats.length > 0 && (
              <div class="hairline pt-5">
                <div class="eyebrow text-risk">What threatens it</div>
                <ul class="mt-3 space-y-2">
                  {d.threats.map((w) => (
                    <li class="flex gap-3 text-[14px] leading-relaxed text-muted">
                      <span class="mt-[9px] h-px w-3 shrink-0 bg-risk" />
                      <span>{w}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>

        {
          chartBars.length > 0 && (
            <div class="mt-6">
              <Figure
                eyebrow="Official projection"
                title={`${d.short} — projected growth`}
                sources={[growth!.source]}
                note={d.horizon ? `BLS projection, ${d.horizon}.` : undefined}
              >
                <RankedBars client:load data={chartBars} height={120} labelWidth={190} unitNote={`Projected growth, ${d.horizon ?? ''}`} />
              </Figure>
            </div>
          )
        }
      </div>

      <aside class="grid gap-6 lg:sticky lg:top-24">
        <div class="hairline pt-5">
          <div class="eyebrow">The four tests</div>
          <h3 class="mt-2 font-display text-[19px]">What protects this job</h3>
          <p class="mt-2 text-[13px] leading-relaxed text-muted">
            Four things that keep a job out of a machine's reach. Score them 0–3 and add them up: the
            higher the total, the harder the job is to automate.
          </p>
          <div class="mt-4">
            <TestBars client:load tests={d.tests} verdict={d.verdict} reading={profile.reading} />
          </div>
        </div>

        {
          d.claims.length > 0 && (
            <div class="hairline pt-5">
              <div class="eyebrow">Verified claims</div>
              <ul class="mt-3 space-y-3">
                {d.claims.map((c) => (
                  <li class="text-[14px] leading-relaxed text-muted">
                    {c.text}{' '}
                    <a
                      href={`/sources#${c.source}`} target="_blank" rel="noopener"
                      class="num whitespace-nowrap rounded border border-line px-1.5 py-0.5 text-[10.5px] text-faint no-underline hover:border-signal hover:text-ink"
                    >
                      {getSource(c.source).short}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>

    <nav class="flex flex-wrap items-center justify-between gap-4 border-t border-line-soft pt-6">
      {
        prev ? (
          <a href={`/jobs/${prev.id}`} class="group no-underline">
            <div class="eyebrow">Previous</div>
            <div class="mt-1 font-display text-[19px] group-hover:text-signal">{prev.data.short}</div>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={`/jobs/${next.id}`} class="group ml-auto text-right no-underline">
            <div class="eyebrow">Next</div>
            <div class="mt-1 font-display text-[19px] group-hover:text-signal">{next.data.short}</div>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</Base>
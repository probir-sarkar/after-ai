---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { sources } from '@/data/sources';
import Cite from '@/components/Cite.tsx';
import Figure from '@/components/Figure.astro';
import StatCard from '@/components/StatCard.astro';
import JobCard from '@/components/JobCard.astro';
import { ChurnChart, EntryLevelChart, TwoTrack } from '@/components/charts/Index';
import Falsification from '@/components/islands/Falsification.tsx';
import { nav, testLabels } from '@/lib/site';

const jobs = (await getCollection('jobs')).sort((a, b) => a.data.order - b.data.order);
const featured = jobs.filter((j) => j.data.featured);

const headline = (j: (typeof jobs)[number]) => {
  const m = j.data.metrics[0];
  return m ? { display: m.display, label: m.label } : undefined;
};
---

<Base>
  <section class="wrap section-tight sm:pt-16">
    <p class="eyebrow rise">Labour-market brief · {jobs.length} job profiles · {sources.length} public sources</p>
    <h1 class="rise mt-5 max-w-[19ch] font-display">The work that stays.</h1>
    <p class="lede rise mt-6">
      AI is not wiping out jobs. It is splitting them: the same job can become more skilled and better
      paid, or simpler and worse paid. Below is what the evidence says about which is which — with the
      source printed next to every number.
    </p>
    <div class="rise mt-8 flex flex-wrap gap-3">
      <a
        href="/survives"
        class="inline-flex min-h-[46px] items-center rounded-full bg-ink px-5 font-mono text-[11.5px] uppercase tracking-[0.14em] text-void no-underline hover:bg-signal"
        >Start with what survives</a
      >
      <a
        href="/risk"
        class="inline-flex min-h-[46px] items-center rounded-full border border-line px-5 font-mono text-[11.5px] uppercase tracking-[0.14em] text-muted no-underline hover:border-signal hover:text-ink"
        >See what is exposed</a
      >
    </div>
  </section>

  <section class="wrap section-tight">
    <div class="grid gap-6 pt-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-x-10">
      <StatCard
        value="1 in 4"
        label="workers worldwide are in an occupation with some generative-AI exposure — but only 3.3% sit in the highest exposure band."
        source="ilo-index"
        tone="emerge"
      />
      <StatCard
        value="−19%"
        label="how far 22–25-year-olds in the most AI-exposed occupations sit below the path they were on. It was 15% a year earlier; experienced workers show no such gap."
        source="stanford-canaries"
        tone="risk"
      />
      <StatCard
        value="+62%"
        label="average wage premium for workers whose jobs require AI skills, up from 57% a year earlier."
        source="pwc-release"
        tone="signal"
      />
      <StatCard
        value="+847,300"
        label="home health and personal care aide jobs projected by 2035 — the largest addition of any occupation in the US economy."
        source="bls-fastest"
        tone="survive"
      />
    </div>
  </section>

  <section class="wrap section">
    <div class="hairline grid gap-6 pt-8 lg:grid-cols-3 lg:gap-x-10">
      <div>
        <h3 class="font-display text-[20px] leading-snug text-survive">Some jobs are hard to automate</h3>
        <p class="mt-2 text-[14.5px] leading-relaxed text-muted">
          They need hands in a place that keeps changing, a person to answer for the result, or a
          relationship with someone. Care work, trades, teaching, medicine.
          <a href="/survives" class="num text-[11.5px] text-ink underline decoration-[var(--color-line)] hover:decoration-signal">see them</a>
        </p>
      </div>
      <div>
        <h3 class="font-display text-[20px] leading-snug text-risk">Some are already shrinking</h3>
        <p class="mt-2 text-[14.5px] leading-relaxed text-muted">
          Mostly routine office work — typing, filing, booking, first-draft writing. The loss lands
          hardest on people just starting out, because the entry-level version is the first to go.
          <a href="/risk" class="num text-[11.5px] text-ink underline decoration-[var(--color-line)] hover:decoration-signal">see the risk</a>
        </p>
      </div>
      <div>
        <h3 class="font-display text-[20px] leading-snug text-emerge">New jobs are appearing</h3>
        <p class="mt-2 text-[14.5px] leading-relaxed text-muted">
          Building AI, installing it inside a company, labelling and checking its output, and watching
          it once it is live. They pay well and they are growing fast.
          <a href="/opportunity" class="num text-[11.5px] text-ink underline decoration-[var(--color-line)] hover:decoration-signal">see them</a>
        </p>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-start lg:gap-16">
      <div>
        <p class="eyebrow">The short answer</p>
        <h2 class="mt-4">Tasks die. Jobs change shape.</h2>
        <div class="prose-body mt-5">
          <p>
            Employers surveyed by the World Economic Forum expect AI and information processing to create
            11 million roles and displace 9 million by 2030, while robots displace 5 million more than
            they create.<Cite ids="wef-fastest" /> That is churn, not collapse — and it is a forecast,
            not an observation.
          </p>
          <p>
            The observed data is sharper and more uncomfortable. In payroll records, employment for
            workers aged 22–25 in the most AI-exposed occupations now sit <em>19%</em> below where they
            would be had they kept pace — up from 15% a year earlier — while experienced workers in those
            same jobs show no comparable gap. The adjustment came through hiring rather than pay, and it
            concentrated where AI <em>automates</em> rather than <em>augments</em>.<Cite ids="stanford-canaries" />
          </p>
          <p>
            So the useful question is not "is this job safe". It is <strong>which half of it
            survives</strong> — and PwC's analysis of a billion job advertisements gives the clearest
            answer available: AI moves a job's required expertise up or down, and the two directions have
            opposite outcomes.<Cite ids="pwc-barometer" />
          </p>
        </div>
      </div>

      <div>
        <p class="eyebrow">The two-track labour market</p>
        <h3 class="mt-3 font-display text-[18px] leading-snug">AI raises the expertise bar — or lowers it</h3>
        <div class="mt-6">
          <TwoTrack client:load />
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="grid gap-10 lg:grid-cols-[1.55fr_1fr] lg:items-start lg:gap-16">
      <Figure
        eyebrow="Employer projections to 2030"
        title="Jobs created and displaced, by technology driver"
        sources={['wef-fastest']}
        note="Survey of 1,000+ employers. Net is created minus displaced. Robots and autonomous systems are shown as a net only — no creation figure was published, so that row is not comparable with the two above."
      >
        <ChurnChart client:load />
      </Figure>

      <div class="pt-9">
        <p class="eyebrow">What to notice</p>
        <ul class="mt-4 space-y-4">
          <li>
            <p class="text-[14.5px] leading-relaxed text-ink">
              The biggest driver employers name is not AI at all — it is people getting online.
            </p>
            <p class="mt-1 text-[13px] leading-relaxed text-faint">
              19M jobs created, 9M displaced, for broadening digital access.
            </p>
          </li>
          <li class="hairline pt-4">
            <p class="text-[14.5px] leading-relaxed text-ink">
              In employers' own projections, AI adds more than it takes away.
            </p>
            <p class="mt-1 text-[13px] leading-relaxed text-faint">
              11M created against 9M displaced — a net +2M, and still a forecast.
            </p>
          </li>
          <li class="hairline pt-4">
            <p class="text-[14.5px] leading-relaxed text-ink">
              Robots are the only driver where displacement wins.
            </p>
            <p class="mt-1 text-[13px] leading-relaxed text-faint">
              A net −5M, with no creation figure published to balance it.
            </p>
          </li>
        </ul>
        <div class="hairline mt-6 pt-4">
          <a href="/risk" class="font-mono text-[11px] uppercase tracking-[0.12em] text-signal no-underline"
            >What the damage looks like →</a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <p class="eyebrow">The four tests</p>
    <h2 class="mt-4 max-w-[26ch]">Four things that keep a job out of a machine's reach.</h2>
    <p class="lede mt-5 max-w-[62ch]">
      They come up again and again in the research. A job with none of them is the one at risk. Each job
      page says how much each one applies, in plain words — our reading, not a measurement.
    </p>
    <div class="hairline mt-10 grid gap-8 pt-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        testLabels.map((t, i) => (
          <div>
            <div class="num text-[11.5px] text-faint">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="mt-2 font-display text-[18px] leading-snug">{t.label}</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-muted">
              {i === 0 &&
                'Work that changes shape daily, where a mistake injures someone. Robots reach about 13% of US work hours against 44% for software agents.'}
              {i === 1 &&
                'Nobody insures a model or puts one on the stand. Indivisible bundles survive: every school still needs a principal.'}
              {i === 2 &&
                'New tasks in AI-exposed roles lean 2.5× harder on empathy, presence, judgement and creativity.'}
              {i === 3 &&
                'Most of today’s skills apply to work that could be automated and work that cannot. The seat stays; the mix changes.'}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap section">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <Figure
        eyebrow="Relative employment change since late 2022"
        title="Who is losing ground"
        sources={['stanford-canaries']}
        note="High-frequency US payroll data through June 2026. The 19% is the shortfall against the path young workers in less-exposed jobs stayed on; adjustments came through hiring, not wages. The second row is a null result, not missing data."
      >
        <EntryLevelChart client:load />
      </Figure>
      <div class="pt-9">
        <p class="eyebrow">Why the four tests are not a slogan</p>
        <h3 class="mt-3 font-display text-[20px]">Unpredictability plus consequence</h3>
        <div class="prose-body mt-4">
          <p>
            The most useful ranking in the literature scores occupations on six O*NET abilities:
            stamina, static strength, reaction time, spatial orientation, time sharing and problem
            sensitivity. Firefighting tops it — not because the work is manual, but because it needs
            real-time decisions in conditions that change, where the outcome hurts someone.
            <Cite ids="resumenow" />
          </p>
          <p>
            That combination, not physical labour by itself, is what the evidence keeps pointing at.
          </p>
        </div>
        <a href="/what-to-do" class="mt-6 inline-block font-mono text-[11.5px] uppercase tracking-[0.14em] text-signal no-underline"
          >Apply the tests →</a
        >
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Profiles</p>
        <h2 class="mt-4">Six roles that carry the argument</h2>
      </div>
      <a href="/jobs" class="font-mono text-[11.5px] uppercase tracking-[0.14em] text-signal no-underline"
        >All {jobs.length} profiles →</a
      >
    </div>
    <div class="mt-4 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((j) => <JobCard {...j.data} id={j.id} headline={headline(j)} />)}
    </div>
  </section>

  <section class="wrap section-tight">
    <p class="eyebrow">Where to go next</p>
    <div class="hairline mt-6 grid gap-x-10 gap-y-6 pt-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        nav.slice(0, 5).map((item, i) => (
          <a href={item.href} class="group block no-underline">
            <div class="num text-[11.5px] text-faint">{String(i + 1).padStart(2, '0')}</div>
            <div class="mt-2 font-display text-[20px] group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">{item.label}</div>
            <p class="mt-2 text-[14px] leading-relaxed text-muted">
              {i === 0 && 'Care, trades, accountability: the work with direct evidence behind it.'}
              {i === 1 && 'What is exposed, how exposure is measured, and why it is not displacement.'}
              {i === 2 && 'The roles being created, with the growth rates attached.'}
              {i === 3 && 'Jobs that don\u2019t exist yet — the patterns the evidence is already pointing at.'}
              {i === 4 && 'Four tests, one instruction, and the three ways this brief could be wrong.'}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="wrap section-tight pb-8">
    <p class="eyebrow">What would change this conclusion</p>
    <h2 class="mt-4 max-w-[26ch]">Four assumptions this brief rests on.</h2>
    <p class="lede mt-5 max-w-[62ch]">
      Stated plainly, because none of the forecasts above are destiny. Each one names the assumption it
      attacks.
    </p>
    <div class="mt-8">
      <Falsification client:load />
    </div>
  </section>
</Base>
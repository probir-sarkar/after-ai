---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { section } from '@/lib/sections';
import { cleanPath, site } from '@/lib/site';
import Cite from '@/components/Cite.tsx';
import Figure from '@/components/Figure.astro';
import Falsification from '@/components/islands/Falsification.tsx';
import { SeniorisedChart } from '@/components/charts/Index';
import { testLabels } from '@/lib/site';

const entry = await section('what-to-do');
const { Content } = await render(entry);

const url = new URL(cleanPath(Astro.url.pathname), Astro.site ?? site.url).href;
const origin = new URL(url).origin;
const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': url,
    url,
    name: entry.data.title,
    description: entry.data.standfirst,
    inLanguage: 'en',
    isPartOf: { '@id': `${origin}/#website` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
      { '@type': 'ListItem', position: 2, name: entry.data.title, item: url },
    ],
  },
];

const evidence: Record<string, { text: string; source: string }> = {
  body: {
    text: 'Robots reach about 13% of US work hours today against 44% for software agents, because machines lack fine motor control and real-time physical judgement.',
    source: 'mckinsey-agents',
  },
  accountability: {
    text: 'Indivisible roles survive: every school still needs a principal, every hospital a medical director, and nobody insures a model.',
    source: 'mckinsey-workforce',
  },
  relationship: {
    text: 'New tasks added to AI-exposed roles since 2022 are 2.5× more likely to depend on empathy, presence, judgement, creativity or leadership.',
    source: 'pwc-barometer',
  },
  bundle: {
    text: 'More than 70% of today’s skills apply to both automatable and non-automatable work — the seat stays, the mix changes.',
    source: 'mckinsey-agents',
  },
};
---

<Base title={entry.data.title} jsonLd={jsonLd} description={entry.data.description ?? entry.data.standfirst}>
  <section class="wrap section-tight sm:pt-16">
    <div class="flex items-center gap-4">
      <span class="num text-[11.5px] text-faint">{entry.data.eyebrow}</span>
      <span class="h-px flex-1 bg-[var(--color-line-soft)]"></span>
      <span class="eyebrow">Four tests · one instruction</span>
    </div>
    <h1 class="mt-6 max-w-[18ch] font-display">{entry.data.title}</h1>
    <p class="lede mt-5">{entry.data.standfirst}</p>
  </section>

  <section class="wrap section-tight">
    <div class="grid gap-x-10 gap-y-6 sm:grid-cols-2">
      {
        testLabels.map((t, i) => (
          <div class="hairline pt-6">
            <div class="flex items-baseline gap-3">
              <span class="num text-[11.5px] text-faint">TEST {i + 1}</span>
            </div>
            <h3 class="mt-3 font-display text-[21px] leading-snug">{t.label}</h3>
            <p class="mt-3 flex-1 text-[14px] leading-relaxed text-muted">{evidence[t.key].text}</p>
            <a
              href={`/sources#${evidence[t.key].source}`} target="_blank" rel="noopener"
              class="num mt-4 w-fit rounded border border-line px-1.5 py-0.5 text-[10.5px] text-faint no-underline hover:border-signal hover:text-ink"
            >
              {evidence[t.key].source}
            </a>
          </div>
        ))
      }
    </div>
    <p class="eyebrow mt-4">
      Note: the 0–3 scoring shown on each job profile is an editorial reading of its task profile, not a
      measurement. The evidence above is sourced.
    </p>
  </section>

  <section class="wrap grid gap-10 pb-16 lg:grid-cols-[1fr_320px] lg:items-start">
    <div class="prose-body max-w-[70ch]">
      <Content components={{ Cite }} />
    </div>
    <aside class="hairline pt-6 lg:sticky lg:top-20">
      <div class="eyebrow">If you remember one number</div>
      <div class="mt-3 num text-[38px] leading-none text-survive">+35%</div>
      <p class="mt-3 text-[14px] leading-relaxed text-muted">
        Growth since 2019 in AI-exposed entry-level roles that were redesigned to demand senior skills.
        Roles that were not shrank 10%.
      </p>
      <div class="hairline mt-4 pt-4">
        <a href="/sources#pwc-barometer" target="_blank" rel="noopener" class="font-mono text-[11px] uppercase tracking-[0.12em] text-signal no-underline"
          >PwC 2026 →</a
        >
      </div>
    </aside>
  </section>

  <section class="wrap section-tight">
    <Figure
      eyebrow="Entry level, split"
      title="The one instruction in the data"
      sources={['pwc-barometer', 'pwc-release']}
      note="Entry-level postings since 2019, split by whether the role was redesigned to demand more than ten traditionally senior skills. Globally, entry-level postings in highly AI-exposed roles have flatlined."
    >
      <SeniorisedChart client:load />
    </Figure>
  </section>

  <section class="wrap section-tight">
    <p class="eyebrow">Three ways to be wrong</p>
    <h2 class="mt-4 max-w-[26ch]">What would have to change for this advice to be bad advice.</h2>
    <div class="mt-8">
      <Falsification client:load />
    </div>
  </section>

  <section class="wrap section-tight">
    <div class="hairline pt-8">
      <p class="eyebrow">The instruction</p>
      <h2 class="mt-4 max-w-[30ch]">Do not avoid AI-exposed fields. Enter them at the expert end.</h2>
      <div class="prose-body mt-4">
        <p>
          The rungs that vanished were the ones where the work <em>was</em> the first draft. What
          replaced them demands judgement, ownership and coordination years earlier than the old ladder
          would have. "Seniorise yourself early" is the whole actionable content of this brief, and it
          is the only recommendation here that a dataset actually supports.
        </p>
        <p>
          The bottleneck is not the jobs — it is the bridge. About one in seven US workers has a direct
          skills pathway from a shrinking occupation into a growing one.<Cite ids="mckinsey-workforce" />
        </p>
      </div>
      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href="/jobs"
          class="inline-flex min-h-[46px] items-center rounded-full bg-ink px-5 font-mono text-[11.5px] uppercase tracking-[0.14em] text-void no-underline hover:bg-signal"
          >Check the profiles</a
        >
        <a
          href="/sources"
          class="inline-flex min-h-[46px] items-center rounded-full border border-line px-5 font-mono text-[11.5px] uppercase tracking-[0.14em] text-muted no-underline hover:border-signal hover:text-ink"
          >Read the sources</a
        >
      </div>
    </div>
  </section>

  <section class="wrap flex flex-wrap items-center justify-between gap-4 border-t border-line-soft py-8">
    <a href="/opportunity" class="font-mono text-[11.5px] uppercase tracking-[0.14em] text-muted no-underline hover:text-ink">← What is coming</a>
    <a href="/jobs" class="font-mono text-[11.5px] uppercase tracking-[0.14em] text-signal no-underline">All profiles →</a>
  </section>
</Base>
---
import '@fontsource-variable/inter';
import '@fontsource/instrument-serif';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '@/styles/global.css';
import { nav, site, cleanPath } from '@/lib/site';
import { sources } from '@/data/sources';

interface Props {
  title?: string;
  description?: string;
  eyebrow?: string;
}

const { title, description = site.description, eyebrow } = Astro.props;

// Astro.url.pathname is the build path with .html appended by build.format:'file',
// so canonical/og:url have to come from the cleaned path, not the raw one.
const path = cleanPath(Astro.url.pathname);
const canonical = new URL(path, Astro.site ?? site.url).href;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const active = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#08080a" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site ?? site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="After AI — which jobs survive, and which are being born" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-ink focus:px-3 focus:py-2 focus:text-void"
      >Skip to content</a
    >

    <header class="sticky top-0 z-40 border-b border-line-soft bg-void/85 backdrop-blur-md">
      <div class="wrap flex flex-wrap items-center gap-x-6 gap-y-2 py-3 sm:py-4">
        <a href="/" class="mr-auto flex items-baseline gap-2 no-underline">
          <span class="font-display text-[26px] leading-none tracking-tight">After AI</span>
          <span class="hidden text-[11px] leading-none text-faint md:inline">work that stays</span>
        </a>
        <nav aria-label="Sections" class="order-3 -mx-1 w-full sm:order-2 sm:mx-0 sm:w-auto">
          <ul class="flex flex-wrap items-center gap-x-1 gap-y-0.5 sm:gap-x-0">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={active(item.href) ? 'page' : undefined}
                    class:list={[
                      'inline-flex min-h-[40px] items-center whitespace-nowrap rounded-full px-3 font-mono text-[11px] uppercase tracking-[0.14em] no-underline transition-colors',
                      active(item.href) ? 'bg-raise text-ink' : 'text-faint hover:text-ink',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a
          href="/sources"
          class="order-2 hidden items-center gap-2 rounded-full border border-line px-3 py-1.5 font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted no-underline hover:border-signal hover:text-ink lg:inline-flex"
        >
          {sources.length} sources
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-24 border-t border-line-soft">
      <div class="wrap grid gap-8 py-12 md:grid-cols-[1.4fr_1fr]">
        <div>
          <div class="font-display text-2xl">{site.name}</div>
          <p class="mt-3 max-w-md text-sm leading-relaxed text-faint">
            {site.tagline}. Every figure is sourced; forecasts are labelled as forecasts, and editorial
            judgements are labelled as editorial.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-6 md:justify-items-end">
          <ul class="space-y-2">
            {
              nav.slice(0, 3).map((item) => (
                <li>
                  <a href={item.href} class="link-quiet font-mono text-[11px] uppercase tracking-[0.12em] no-underline">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <ul class="space-y-2">
            {
              nav.slice(3).map((item) => (
                <li>
                  <a href={item.href} class="link-quiet font-mono text-[11px] uppercase tracking-[0.12em] no-underline">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="wrap flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-line-soft py-6">
        <span class="eyebrow">Built from public data — no paywall, no newsletter</span>
        <span class="eyebrow ml-auto">Built {new Date().toISOString().slice(0, 10)}</span>
      </div>
    </footer>
  </body>
</html>
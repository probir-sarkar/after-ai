---
import '@fontsource-variable/inter';
import '@fontsource/instrument-serif';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '@/styles/global.css';
import { nav, site, cleanPath } from '@/lib/site';
import { sources } from '@/data/sources';

interface Props {
  title?: string;
  description?: string;
  eyebrow?: string;
  /** Per-page schema; the site-level WebSite/Organization graph is always emitted. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** 'article' for a job profile, 'website' everywhere else. */
  ogType?: 'website' | 'article';
  /** Absolute or root-relative social image. */
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  jsonLd,
  ogType = 'website',
  image = '/og.png',
  noindex = false,
} = Astro.props;

const base = Astro.site ?? new URL(site.url);

// Astro.url.pathname is the build path with .html appended by build.format:'file',
// so canonical/og:url have to come from the cleaned path, not the raw one.
const path = cleanPath(Astro.url.pathname);
const canonical = new URL(path, base).href;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const absImage = new URL(image, base).href;
const active = (href: string) => path === href || path.startsWith(`${href}/`);
const built = new Date().toISOString().slice(0, 10);

const graph = [
  {
    '@type': 'WebSite',
    '@id': `${base.origin}/#website`,
    url: `${base.origin}/`,
    name: site.name,
    description: site.description,
    inLanguage: 'en',
    publisher: { '@id': `${base.origin}/#publisher` },
  },
  {
    '@type': 'Organization',
    '@id': `${base.origin}/#publisher`,
    name: site.name,
    url: `${base.origin}/`,
    description: site.tagline,
    sameAs: [site.repo],
  },
];

const pageGraph = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const schema = { '@context': 'https://schema.org', '@graph': [...graph, ...pageGraph] };
const schemaJson = JSON.stringify(schema).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1'} />
    <meta name="author" content={site.name} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#08080a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f6f0" media="(prefers-color-scheme: light)" />
    <script is:inline>
      // Runs before paint: no flash of the wrong theme.
      (() => {
        try {
          const fromUrl = new URLSearchParams(location.search).get('theme');
          const stored = fromUrl === 'light' || fromUrl === 'dark' ? fromUrl : localStorage.getItem('theme');
          const system = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          document.documentElement.dataset.theme = stored === 'light' || stored === 'dark' ? stored : system;
          if (fromUrl === 'light' || fromUrl === 'dark') localStorage.setItem('theme', fromUrl);
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absImage} />
    <meta name="twitter:image:alt" content={`${site.name} — ${site.tagline}`} />

    <script type="application/ld+json" is:inline set:html={schemaJson} />
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-ink focus:px-3 focus:py-2 focus:text-void"
      >Skip to content</a
    >

    <header class="z-40 border-b border-line-soft bg-void/90 backdrop-blur md:sticky md:top-0">
      <div class="wrap flex flex-wrap items-center gap-x-5 gap-y-1 py-2.5">
        <a href="/" class="mr-auto flex items-baseline gap-2 no-underline">
          <span class="font-display text-[22px] leading-none tracking-tight">After AI</span>
        </a>

        <nav aria-label="Sections" class="order-3 w-full sm:order-2 sm:w-auto">
          <ul class="flex flex-wrap items-center gap-x-4 gap-y-1">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={active(item.href) ? 'page' : undefined}
                    class:list={[
                      'inline-flex min-h-[32px] items-center whitespace-nowrap text-[13px] no-underline transition-colors',
                      active(item.href)
                        ? 'text-ink underline decoration-signal decoration-1 underline-offset-[6px]'
                        : 'text-faint hover:text-ink',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <button
          id="theme-toggle"
          type="button"
          class="order-2 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-faint transition-colors hover:text-ink"
          aria-label="Switch colour theme"
        >
          <svg class="theme-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <svg class="theme-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2" />
            <path d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-20 border-t border-line-soft">
      <div class="wrap grid gap-6 py-10 sm:grid-cols-[1fr_auto] sm:items-start">
        <div>
          <div class="font-display text-[20px]">{site.name}</div>
          <p class="mt-2 max-w-[44ch] text-[13.5px] leading-relaxed text-faint">
            {site.tagline}. Every figure is sourced; forecasts are labelled as forecasts, and editorial
            judgements as editorial.
          </p>
        </div>
        <ul class="flex flex-wrap gap-x-5 gap-y-1 sm:justify-end">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="whitespace-nowrap text-[13px] text-faint no-underline hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="wrap flex flex-wrap items-center gap-x-5 gap-y-1 border-t border-line-soft py-4">
        <a
          href={site.repo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-[12.5px] text-faint no-underline hover:text-ink"
        >
          <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
          </svg>
          Open source on GitHub
        </a>
        <span class="eyebrow ml-auto">Built {new Date().toISOString().slice(0, 10)}</span>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        const root = document.documentElement;
        const sync = () => {
          const light = root.dataset.theme === 'light';
          btn.setAttribute('aria-label', light ? 'Switch to dark mode' : 'Switch to light mode');
          btn.setAttribute('title', light ? 'Switch to dark mode' : 'Switch to light mode');
        };
        sync();
        btn.addEventListener('click', () => {
          const next = root.dataset.theme === 'light' ? 'dark' : 'light';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {}
          sync();
        });
      })();
    </script>
  </body>
</html>
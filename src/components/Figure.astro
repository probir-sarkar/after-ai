---
import { getSource } from '@/data/sources';

interface Props {
  title: string;
  eyebrow?: string;
  note?: string;
  sources: string[];
  class?: string;
  scroll?: boolean;
}

const { title, eyebrow, note, sources, class: klass = '', scroll = true } = Astro.props;
const refs = sources.map(getSource);
---

<figure class:list={['panel overflow-hidden', klass]}>
  <figcaption class="flex flex-wrap items-start gap-x-4 gap-y-1 border-b border-line-soft px-5 py-4">
    <div class="min-w-0">
      {eyebrow && <div class="eyebrow mb-1">{eyebrow}</div>}
      <h3 class="font-display text-[19px] leading-snug">{title}</h3>
    </div>
    <div class="ml-auto flex flex-wrap items-center gap-1">
      {
        refs.map((s) => (
          <a
            href={`/sources#${s.id}`} target="_blank" rel="noopener"
            class="num rounded border border-line px-1.5 py-0.5 text-[9.5px] text-faint no-underline hover:border-signal hover:text-ink"
            title={`${s.title} — ${s.publisher}, ${s.year}`}
          >
            {s.short}
          </a>
        ))
      }
    </div>
  </figcaption>

  <div class:list={['px-3 py-4 sm:px-5', scroll && 'chart-scroll overflow-x-auto']}>
    <slot />
  </div>

  {
    note && (
      <div class="border-t border-line-soft px-5 py-3 text-[11.5px] leading-relaxed text-faint">
        {note}
      </div>
    )
  }
</figure>
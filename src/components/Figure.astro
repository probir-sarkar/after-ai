---
import { getSource } from '@/data/sources';

interface Props {
  title: string;
  eyebrow?: string;
  note?: string;
  sources: string[];
  class?: string;
  scroll?: boolean;
}

const { title, eyebrow, note, sources, class: klass = '', scroll = true } = Astro.props;
const refs = sources.map(getSource);
---

<figure class:list={['figure', klass]}>
  <div class="figure-head">
    <div class="min-w-0">
      {eyebrow && <div class="eyebrow mb-1">{eyebrow}</div>}
      <h3 class="font-display text-[18px] leading-snug text-ink">{title}</h3>
    </div>
    <div class="ml-auto flex flex-wrap items-center gap-1">
      {
        refs.map((s) => (
          <a
            href={`/sources#${s.id}`}
            target="_blank"
            rel="noopener"
            class="num rounded border border-line px-1.5 py-0.5 text-[10px] text-faint no-underline hover:border-signal hover:text-ink"
            title={`${s.title} — ${s.publisher}, ${s.year}`}
          >
            {s.short}
          </a>
        ))
      }
    </div>
  </div>

  <div class:list={['pt-1', scroll && 'chart-scroll overflow-x-auto']}>
    <slot />
  </div>

  {
    note && (
      <figcaption class="mt-3 max-w-[70ch] border-t border-line-soft pt-2 text-[12px] leading-relaxed text-faint">
        {note}
      </figcaption>
    )
  }
</figure>

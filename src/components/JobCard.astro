---
import { categoryMeta, verdictMeta, type Verdict } from '@/lib/site';

interface Props {
  id: string;
  name: string;
  verdict: Verdict;
  category: string;
  oneLiner: string;
  /** Kept for call-site compatibility; the card no longer shows a figure. */
  headline?: { display: string; label: string } | undefined;
}

const { id, name, verdict, category, oneLiner } = Astro.props;
const v = verdictMeta[verdict];
---

<a
  href={`/jobs/${id}`}
  data-verdict={verdict}
  data-category={category}
  class="job-card group block border-t border-line py-4 no-underline"
>
  <div class="flex items-center gap-2">
    <span class="h-[7px] w-[7px] shrink-0 rounded-full" style={`background:${v.color}`} aria-hidden="true"></span>
    <span class="eyebrow">{categoryMeta[category] ?? category}</span>
    <span class="eyebrow ml-auto opacity-0 transition-opacity group-hover:opacity-100">{v.label}</span>
  </div>

  <h3 class="mt-2 font-display text-[21px] leading-[1.12] text-ink group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">
    {name}
  </h3>

  <p class="mt-1.5 max-w-[46ch] text-[14px] leading-relaxed text-muted">{oneLiner}</p>
</a>

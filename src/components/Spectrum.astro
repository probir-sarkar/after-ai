---
import { spectrum } from '@/data/series';
import { getSource } from '@/data/sources';

interface Props {
  side: 'most' | 'least';
  title: string;
  caption: string;
}

const { side, title, caption } = Astro.props;
const list = side === 'most' ? spectrum.most : spectrum.least;
const src = getSource(spectrum.source);
const tone = side === 'most' ? 'var(--color-risk)' : 'var(--color-survive)';
---

<figure class="panel overflow-hidden">
  <figcaption class="flex flex-wrap items-center gap-3 border-b border-line-soft px-5 py-4">
    <h3 class="font-display text-[19px]">{title}</h3>
    <a
      href={`/sources#${src.id}`} target="_blank" rel="noopener"
      class="num ml-auto rounded border border-line px-1.5 py-0.5 text-[9.5px] text-faint no-underline hover:border-signal hover:text-ink">{src.short}</a
    >
  </figcaption>
  <ul class="divide-y divide-[var(--color-line-soft)]">
    {
      list.map((item, i) => (
        <li class="flex items-baseline gap-4 px-5 py-[11px]">
          <span class="num w-6 shrink-0 text-[11px]" style={`color:${tone}`}>
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="text-[14.5px] leading-snug text-ink">{item}</span>
        </li>
      ))
    }
  </ul>
  <div class="border-t border-line-soft px-5 py-3 text-[11.5px] leading-relaxed text-faint">{caption}</div>
</figure>
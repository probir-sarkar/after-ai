---
import { getSource } from '@/data/sources';

interface Props {
  value: string;
  label: string;
  source: string;
  tone?: 'survive' | 'risk' | 'emerge' | 'signal';
}

const { value, label, source, tone = 'signal' } = Astro.props;
const src = getSource(source);
const color = `var(--color-${tone})`;
---

<div class="panel flex flex-col p-5">
  <div class="num text-[clamp(1.7rem,3.4vw,2.4rem)] leading-none" style={`color:${color}`}>{value}</div>
  <p class="mt-3 flex-1 text-[13px] leading-relaxed text-muted">{label}</p>
  <a
    href={`/sources#${src.id}`}
    class="num mt-4 w-fit rounded border border-line px-1.5 py-0.5 text-[9.5px] text-faint no-underline hover:border-signal hover:text-ink">{src.short}</a
  >
</div>

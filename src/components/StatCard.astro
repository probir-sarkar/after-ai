---
import { getSource } from '@/data/sources';

interface Props {
  value: string;
  label: string;
  source: string;
  tone?: 'survive' | 'risk' | 'emerge' | 'signal';
}

const { value, label, source, tone = 'signal' } = Astro.props;
const src = getSource(source);
const color = `var(--color-${tone})`;
---

<div class="border-t border-line pt-3">
  <div class="num text-[clamp(1.55rem,2.4vw,2rem)] leading-none" style={`color:${color}`}>{value}</div>
  <p class="mt-2 max-w-[30ch] text-[13px] leading-relaxed text-muted">{label}</p>
  <a
    href={`/sources#${src.id}`}
    target="_blank"
    rel="noopener"
    class="num mt-2 inline-block text-[10.5px] text-faint no-underline hover:text-ink">{src.short}</a
  >
</div>
